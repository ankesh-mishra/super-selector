# ── Database (used inside devcontainer — db = postgres service name) ──────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/superselector

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-change-in-production-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Google OAuth (get from https://console.cloud.google.com) ─────────────────
# Leave blank locally if testing with email/password auth
GOOGLE_CLIENT_ID=

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ────────────────────────────────────────────────────────────────────────────
# PRODUCTION (Railway)
# ────────────────────────────────────────────────────────────────────────────
# Railway injects DATABASE_URL automatically from the linked Postgres plugin.
# Set these manually in the Railway service's Variables tab:
#
# Backend service:
#   DATABASE_URL        — auto-injected by Railway Postgres plugin
#   JWT_SECRET_KEY      — generate with: openssl rand -hex 32
#   ENVIRONMENT         = production
#   CORS_ORIGINS        = https://your-frontend.up.railway.app
#
# Frontend service:
#   VITE_API_URL        = https://your-backend.up.railway.app
